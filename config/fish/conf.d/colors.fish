# Syntax highlighting colors
set -g fish_color_normal brwhite
set -g fish_color_command brwhite
set -g fish_color_keyword brwhite
set -g fish_color_quote '#bae6ff'
set -g fish_color_redirection brwhite
set -g fish_color_end brwhite
set -g fish_color_error brwhite
set -g fish_color_param brwhite
set -g fish_color_comment '#878d96'
set -g fish_color_operator brwhite
set -g fish_color_escape brwhite
set -g fish_color_autosuggestion '#4d5358'
set -g fish_color_valid_path
set -g fish_color_selection --background="#012749"
set -g fish_color_search_match --background=brblack

# Pager colors (tab completions)
set -g fish_pager_color_prefix white
set -g fish_pager_color_completion white
set -g fish_pager_color_description white
set -g fish_pager_color_selected_background --background=brblack
